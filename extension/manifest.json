{
  "manifest_version": 3,
  "name": "我的岗位库",
  "version": "0.3.0",
  "description": "在 BOSS 浏览时,一键把当前页面的岗位信息存进本机知识库。AI 提取,不用管接口。数据只到 localhost。",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.zhipin.com/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.zhipin.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "我的岗位库"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
