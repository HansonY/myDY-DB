# 复制为 .env 后填写。.env 已被 .gitignore 忽略,绝不会提交。
#
# ⚠️ 安全须知:抖音 cookie 等同于账号控制权。
#    它只保存在你自己这台机器上,本项目不会上传到任何服务器。
#    切勿把 .env 分享给他人或粘贴到公开场所。

# ── 抖音登录态(必填)─────────────────────────────
# 获取:浏览器登录 www.douyin.com → 开发者工具(F12)→ Network
#      → 刷新页面 → 点任一 www.douyin.com 请求
#      → Request Headers → 复制 Cookie 后面的整串值
DOUYIN_COOKIE=

# 采集「点赞」列表时需要(只采收藏可留空)
# 你自己的主页地址,例如 https://www.douyin.com/user/MS4wLjABAAAA...
DOUYIN_PROFILE_URL=

# ── AI 模型(Phase 2 起需要;Phase 1 可留空)────────
# 阿里云百炼(通义千问):文本 qwen-plus,视觉 qwen-vl-plus
DASHSCOPE_API_KEY=

# ── 采集行为(默认值已偏保守,不确定就别改)──────────
# 单次采集最多拉取条数(0 = 不限)
COLLECT_MAX_ITEMS=0
# 每页条数
COLLECT_PAGE_SIZE=20
# 翻页间隔秒数(同时是 HTTP 超时,f2 的设计)。
# 调大更安全 —— 抖音对高频请求有风控。首次全量采集建议保持默认或更大。
COLLECT_PAGE_DELAY=8

# ── 存储 ────────────────────────────────────────
DB_PATH=data/douyin.db
